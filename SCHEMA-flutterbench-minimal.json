                "passedAllTrials": false,
                "meanTokens": 24992,
                "meanCost": 0.043
              },
              "trials": [
                {
                  "trialIndex": 1,
                  "outcome": 1.0,
                  "quality": 0.96,
                  "dx": 0.95,
                  "tokens": 23488,
                  "cost": 0.0404,
                  "status": "passed",
                  "durationSeconds": 71.2
                },
                {
                  "trialIndex": 2,
                  "outcome": 1.0,
                  "quality": 0.95,
                  "dx": 0.92,
                  "tokens": 24502,
                  "cost": 0.0421,
                  "status": "passed"
                },
                {
                  "trialIndex": 3,
                  "outcome": 1.0,
                  "quality": 0.98,
                  "dx": 0.94,
                  "tokens": 25491,
                  "cost": 0.0438,
                  "status": "passed"
                },
                {
                  "trialIndex": 4,
                  "outcome": 0.0,
                  "quality": 0.41,
                  "dx": 0.6,
                  "tokens": 26487,
                  "cost": 0.0457,
