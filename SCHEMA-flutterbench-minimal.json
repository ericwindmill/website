{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter.dev/flutterbench/results.schema.json",
  "title": "Flutter Bench results payload",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshot",
    "runs"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "examples": [
        "2.0"
      ]
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "runs": {
      "$comment": "Baseline-vs-tooling deltas are deliberately NOT precomputed. They belong to a row pairing this file does not model, and subtracting two already-reviewed numbers cannot drift the way a weighted mean can. The UI computes them.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "snapshot": {
      "title": "Snapshot metadata",
      "type": "object",
      "required": [
        "id",
        "label",
        "generatedAt",
        "status",
        "trialsPerTask",
        "scoring"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "examples": [
            "2026-q1",
            "2026-04-15"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Q1 2026"
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "examples": [
            "2026-04-15T17:04:00Z"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "archived"
          ]
        },
        "trialsPerTask": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            4
          ]
        },
        "scoring": {
          "$ref": "#/$defs/scoring"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flutterVersion": {
              "type": "string",
              "examples": [
                "3.38.1"
              ]
            },
            "dartVersion": {
              "type": "string",
              "examples": [
                "3.10.0"
              ]
            },
            "suiteVersion": {
              "type": "string",
              "examples": [
                "cuj-v1.2.0"
              ]
            },
            "harnessVersion": {
              "type": "string"
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scoring": {
      "title": "Scoring parameters",
      "type": "object",
      "required": [
        "outcomeWeight",
        "qualityWeight",
        "dxWeight",
        "passThreshold"
      ],
      "additionalProperties": false,
      "properties": {
        "outcomeWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "examples": [
            0.6
          ]
        },
        "qualityWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "examples": [
            0.3
          ]
        },
        "dxWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "examples": [
            0.1
          ]
        },
        "passThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "examples": [
            1.0
          ]
        }
      }
    },
    "run": {
      "title": "Agent/model run under one variant",
      "type": "object",
      "required": [
        "agentId",
        "agent",
        "modelId",
        "model",
        "variant",
        "metrics",
        "tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "examples": [
            "claude-code",
            "antigravity",
            "codex"
          ]
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Claude Code",
            "Antigravity",
            "Codex"
          ]
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "claude-sonnet-4-5-20250929"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Claude Sonnet 4.5",
            "Gemini 2.5 Pro"
          ]
        },
        "modelProvider": {
          "type": "string",
          "examples": [
            "Anthropic",
            "Google",
            "OpenAI"
          ]
        },
        "variant": {
          "type": "string",
          "enum": [
            "baseline",
            "ai_tooling"
          ]
        },
        "startedAt": {
          "format": "date-time"
        },
        "completedAt": {
          "format": "date-time"
        },
        "metrics": {
          "$ref": "#/$defs/runMetrics"
        },
        "tasks": {
          "$comment": "Task ids must be unique within a run — JSON Schema cannot express that, so the producer must enforce it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "runMetrics": {
      "title": "Precomputed run-level metrics",
      "type": "object",
      "required": [
        "totalTasks",
        "passedTaskCount",
        "passAtKTaskCount",
        "passRate",
        "passAtKRate",
        "avgScore",
        "scoreSd",
        "avgOutcome",
        "avgQuality",
        "avgDx",
        "avgTokens",
        "avgCost"
      ],
      "additionalProperties": false,
      "properties": {
        "totalTasks": {
          "type": "integer",
          "minimum": 1
        },
        "passedTaskCount": {
          "type": "integer",
          "minimum": 0
        },
        "passAtKTaskCount": {
          "type": "integer",
          "minimum": 0
        },
        "passRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "passAtKRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "avgScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "scoreSd": {
          "type": "number",
          "minimum": 0
        },
        "avgOutcome": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "avgQuality": {
          "minimum": 0,
          "maximum": 100
        },
        "avgDx": {
          "minimum": 0,
          "maximum": 100
        },
        "avgTokens": {
          "type": "integer",
          "minimum": 0
        },
        "avgCost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "task": {
      "title": "One CUJ (critical user journey) within a run",
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "metrics",
        "trials"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cuj-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$",
          "examples": [
            "cuj-01-renderflex-overflow",
            "cuj-06-dart-genkit-function"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Fix RenderFlex Overflow"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "short_horizon",
            "long_horizon"
          ]
        },
        "metrics": {
          "$ref": "#/$defs/taskMetrics"
        },
        "trials": {
          "$comment": "trialIndex values must be unique and cover 1..K — JSON Schema cannot express that, so the producer must enforce it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trial"
          }
        }
      }
    },
    "taskMetrics": {
      "title": "Precomputed task-level metrics",
      "type": "object",
      "required": [
        "resultScore",
        "outcome",
        "quality",
        "dx",
        "passedTrialCount",
        "passedAnyTrial",
        "passedAllTrials",
        "meanTokens",
        "meanCost"
      ],
      "additionalProperties": false,
      "properties": {
        "resultScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "outcome": {
          "minimum": 0,
          "maximum": 100
        },
        "quality": {
          "minimum": 0,
          "maximum": 100
        },
        "dx": {
          "minimum": 0,
          "maximum": 100
        },
        "passedTrialCount": {
          "type": "integer",
          "minimum": 0
        },
        "passedAnyTrial": {
          "type": "boolean"
        },
        "passedAllTrials": {
          "type": "boolean"
        },
        "meanTokens": {
          "type": "integer",
          "minimum": 0
        },
        "meanCost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "trial": {
      "title": "One trial execution (raw measurement)",
      "type": "object",
      "required": [
        "trialIndex",
        "outcome",
        "quality",
        "dx",
        "tokens",
        "cost"
      ],
      "additionalProperties": false,
      "properties": {
        "trialIndex": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "error",
            "timeout"
          ]
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "2.0",
      "snapshot": {
        "id": "2026-q1",
        "label": "Q1 2026",
        "generatedAt": "2026-04-15T17:04:00Z",
        "status": "current",
        "trialsPerTask": 4,
        "scoring": {
          "outcomeWeight": 0.6,
          "qualityWeight": 0.3,
          "dxWeight": 0.1,
          "passThreshold": 1.0
        },
        "environment": {
          "flutterVersion": "3.38.1",
          "dartVersion": "3.10.0",
          "suiteVersion": "cuj-v1.0.0",
          "harnessVersion": "flutter-ai-harness-v1.0.0"
        }
      },
      "runs": [
        {
          "agentId": "antigravity",
          "agent": "Antigravity",
          "modelId": "gemini-2-5-pro",
          "model": "Gemini 2.5 Pro",
          "modelProvider": "Google",
          "variant": "ai_tooling",
          "startedAt": "2026-04-12T09:00:00Z",
          "completedAt": "2026-04-12T11:42:00Z",
          "metrics": {
            "totalTasks": 1,
            "passedTaskCount": 0,
            "passAtKTaskCount": 1,
            "passRate": 0.0,
            "passAtKRate": 100.0,
            "avgScore": 78.275,
            "scoreSd": 0.0,
            "avgOutcome": 75.0,
            "avgQuality": 82.5,
            "avgDx": 85.25,
            "avgTokens": 24992,
            "avgCost": 0.043
          },
          "tasks": [
            {
              "id": "cuj-01-renderflex-overflow",
              "name": "Fix RenderFlex Overflow",
              "category": "short_horizon",
              "metrics": {
                "resultScore": 78.275,
                "outcome": 75.0,
                "quality": 82.5,
